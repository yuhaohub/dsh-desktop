{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.0",
  "description": "Desktop shell for DeepSeek Harness: spawns (or attaches to) the dsh web server and hosts it in an Electron window with tray support",
  "main": "main.js",
  "license": "MIT",
  "author": "DeepSeek Harness Desktop contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuhaohub/dsh-desktop.git"
  },
  "homepage": "https://github.com/yuhaohub/dsh-desktop",
  "bugs": {
    "url": "https://github.com/yuhaohub/dsh-desktop/issues"
  },
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "start": "node scripts/make-icon.mjs && electron .",
    "dist": "node scripts/make-icon.mjs && electron-builder --publish never",
    "dist:arm64": "node scripts/make-icon.mjs && electron-builder --arm64 --publish never",
    "dist:x64": "node scripts/make-icon.mjs && electron-builder --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "files": [
      "main.js",
      "scripts/locate.js",
      "scripts/update-check.js",
      "scripts/apply-update.js",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip",
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "yuhaohub",
      "repo": "dsh-desktop"
    }
  }
}
